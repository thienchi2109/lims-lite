# Compose identity
COMPOSE_PROJECT_NAME=lims-lite

# PostgreSQL and Supabase secrets
POSTGRES_PASSWORD=replace-with-production-value
JWT_SECRET=replace-with-production-value
ANON_KEY=replace-with-production-value
SERVICE_ROLE_KEY=replace-with-production-value
SECRET_KEY_BASE=replace-with-production-value
DB_ENC_KEY=replace-with-production-value

# Public URLs
SITE_URL=https://cdclims.cloud
API_EXTERNAL_URL=https://cdclims.cloud
NEXT_PUBLIC_APP_URL=https://cdclims.cloud
NEXT_PUBLIC_SUPABASE_URL=https://cdclims.cloud
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-production-value
ADDITIONAL_REDIRECT_URLS=

# Internal services
GOTENBERG_URL=http://pdf-gateway:8080
CLIENT_RESOLUTION_SHADOW_CATEGORIES=off
CLIENT_RESOLUTION_SHADOW_TIMEOUT_MS=500
CLIENT_RESOLUTION_V2_CATEGORIES=off
CLIENT_RESOLUTION_LEGACY_UPSERT=on
PDF_GATEWAY_CLIENT_POLICY_FILE=/opt/lims-lite-secrets/pdf-gateway-client-policy.json
PDF_GATEWAY_LIMS_TOKEN_FILE=/opt/lims-lite-secrets/pdf-gateway-lims-token
VIETNAMESE_ADDRESS_SERVICE_URL=
VIETNAMESE_ADDRESS_SERVICE_TIMEOUT_MS=1500
APPROVAL_BATCH_WORKER_DATABASE_PASSWORD_FILE=/opt/lims-lite-secrets/approval-batch-worker-database-password
APPROVAL_BATCH_WORKER_CONCURRENCY=8
APPROVAL_BATCH_WORKER_CLAIM_LEASE_SECONDS=60
APPROVAL_BATCH_WORKER_DRAIN_TIMEOUT_MS=25000
APPROVAL_BATCH_WORKER_HEALTH_PORT=8081

# Authentication behavior
DISABLE_SIGNUP=true
ENABLE_EMAIL_SIGNUP=false
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_EMAIL_PROVIDER=true
GOTRUE_REFRESH_TOKEN_EXPIRY=2592000
JWT_EXPIRY=3600
PGRST_DB_SCHEMAS=public,storage,graphql_public

# Manager and confidential-result OTP
MANAGER_EMAIL_OTP_ENABLED=FALSE
MANAGER_HIV_EMAIL_OTP_ENABLED=FALSE
ANALYST_HIV_EMAIL_OTP_ENABLED=FALSE
BACKGROUND_BATCH_RESULT_APPROVAL_ENABLED=FALSE
MANAGER_OTP_EMAIL_PROVIDER=noop
RESEND_API_KEY=
MANAGER_OTP_EMAIL_FROM=
MANAGER_OTP_EMAIL_REPLY_TO=

# Existing Cloudflare Tunnel token; never rotate during migration
CLOUDFLARE_TUNNEL_TOKEN=replace-with-production-value

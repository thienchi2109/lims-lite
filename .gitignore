# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel
env.md
# typescript
*.tsbuildinfo
next-env.d.ts
.vscode
# python
__pycache__/
*.pyc

# database backups (sensitive data - do not commit)
*.sql
*.dump
*.backup
*.tar.gz
/backups/
/lims-backup-*/
VPS keys
# Exception: migrations should be version controlled
!supabase/migrations/*.sql
!tests/*.sql
nul

# bv (beads viewer) local config and caches
.bv/

# Claude Code local files
.claude/settings.local.json
.claude/context-save-*.md
.claude/hookify.*.local.md
.claude/skills/notebooklm
.gitnexus/

# Documentation references (local/temporary)
docs/references/
.beads/
